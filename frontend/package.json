{
  "name": "@lingjiuu/aether",
  "version": "0.1.9",
  "description": "Aether CLI",
  "type": "module",
  "bin": {
    "aether": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "smoke": "tsx src/smoke/stdioSmoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cli-truncate": "6.0.0",
    "marked": "18.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
